<module name="">

    <enum name="WeaponType" comment="武器类型（对照鸭科夫参考表）">
        <var name="Rifle" value="0" comment="步枪"/>
        <var name="Smg" value="1" comment="冲锋枪"/>
        <var name="Pistol" value="2" comment="手枪"/>
        <var name="Shotgun" value="3" comment="霰弹枪"/>
        <var name="Sniper" value="4" comment="狙击枪（预留）"/>
        <var name="Lmg" value="5" comment="轻机枪（预留）"/>
    </enum>

    <enum name="FireMode" comment="射击模式（自动化）">
        <var name="FullAuto" value="0" comment="全自动"/>
        <var name="SemiAuto" value="1" comment="半自动"/>
    </enum>

    <enum name="AttachmentSlotType" comment="武器配件槽位类型">
        <var name="Grip" value="0" comment="握把"/>
        <var name="Muzzle" value="1" comment="枪口"/>
        <var name="Stock" value="2" comment="枪托"/>
        <var name="Magazine" value="3" comment="弹匣"/>
        <var name="Optic" value="4" comment="瞄具"/>
        <var name="Tactical" value="5" comment="战术设备"/>
    </enum>

    <enum name="AttachmentStatType" comment="配件可修改的武器属性">
        <var name="FireRate" value="0" comment="射速"/>
        <var name="MagazineCapacity" value="1" comment="弹匣容量"/>
        <var name="ReloadTime" value="2" comment="换弹时间"/>
        <var name="AdsTime" value="3" comment="瞄准时间"/>
        <var name="MoveSpeedMul" value="4" comment="移动速度系数"/>
        <var name="AdsMoveSpeedMul" value="5" comment="瞄准移动系数"/>
        <var name="HipSpreadBase" value="6" comment="腰射基础散布"/>
        <var name="HipSpreadMax" value="7" comment="腰射最大散布"/>
        <var name="HipSpreadGrowth" value="8" comment="每发散布增长"/>
        <var name="HipSpreadRecover" value="9" comment="散布恢复速度"/>
        <var name="VerticalRecoil" value="10" comment="垂直后坐力"/>
        <var name="HorizontalRecoil" value="11" comment="水平后坐力"/>
        <var name="SoundMultiplier" value="12" comment="声音倍率"/>
        <var name="Damage" value="13" comment="枪械伤害"/>
        <var name="CritRate" value="14" comment="暴击率"/>
        <var name="MaxAimDistance" value="15" comment="最大瞄准距离"/>
        <var name="AimCameraMaxOffset" value="16" comment="瞄准相机最大偏移距离"/>
    </enum>

    <enum name="AttachmentModifierMode" comment="配件属性叠加方式">
        <var name="FlatAdd" value="0" comment="固定值加算"/>
        <var name="RateAdd" value="1" comment="相对基础值的比例加算"/>
    </enum>

    <enum name="ItemType" comment="物品类型">
        <var name="Other" value="0" comment="其他"/>
        <var name="Medicine" value="1" comment="药品"/>
        <var name="Weapon" value="2" comment="武器"/>
        <var name="Ammo" value="3" comment="弹药"/>
        <var name="Equipment" value="4" comment="装备"/>
        <var name="Attachment" value="5" comment="配件"/>
        <var name="MeleeWeapon" value="6" comment="近战武器"/>
    </enum>

    <enum name="MedicineType" comment="药品类型">
        <var name="Heal" value="0" comment="回血类"/>
        <var name="Boost" value="1" comment="增益类"/>
        <var name="Cleanse" value="2" comment="净化类"/>
    </enum>

    <enum name="BuffTag" comment="Buff 分类标签">
        <var name="DamageBuff" value="0" comment="输出增益"/>
        <var name="DamageDebuff" value="1" comment="输出减益"/>
        <var name="MoveBuff" value="2" comment="移动增益"/>
        <var name="MoveDebuff" value="3" comment="移动减益"/>
        <var name="InstantHeal" value="4" comment="单次治疗"/>
        <var name="HealOverTime" value="5" comment="持续治疗"/>
        <var name="InstantDamage" value="6" comment="单次受伤"/>
        <var name="DamageOverTime" value="7" comment="持续受伤"/>
        <var name="StaminaBuff" value="8" comment="体力增益"/>
        <var name="StaminaDebuff" value="9" comment="体力减益"/>
        <var name="WeightBuff" value="10" comment="负重"/>
        <var name="DefenseBuff" value="11" comment="防御增益"/>
        <var name="DefenseDebuff" value="12" comment="防御减益"/>
    </enum>

    <enum name="BuffConflictPolicy" comment="How a new Buff handles conflicting active Buffs">
        <var name="BothRemove" value="0" comment="Remove old conflicting Buffs and reject the new Buff"/>
        <var name="RejectNew" value="1" comment="Keep old Buffs and reject the new Buff"/>
        <var name="ReplaceOld" value="2" comment="Remove old Buffs and apply the new Buff"/>
    </enum>

    <enum name="BuffDurationMode" comment="Buff duration behavior">
        <var name="StrongPermanent" value="0" comment="Permanent and immune to conflict removal"/>
        <var name="WeakPermanent" value="1" comment="Permanent but removable by conflicts"/>
        <var name="Timed" value="2" comment="Timed Buff"/>
    </enum>

    <enum name="BuffRepeatPolicy" comment="How duplicate Buff applications are handled">
        <var name="RejectNew" value="0" comment="Reject the new application"/>
        <var name="ExtendOld" value="1" comment="Extend the existing duration"/>
        <var name="ReplaceOld" value="2" comment="Replace the existing instance"/>
        <var name="Stack" value="3" comment="Increase stack count"/>
    </enum>

    <enum name="BuffStackDurationPolicy" comment="How stacked Buff durations are tracked">
        <var name="Independent" value="0" comment="Each stack has its own timer"/>
        <var name="Oldest" value="1" comment="All stacks expire with the oldest timer"/>
        <var name="Latest" value="2" comment="All stacks refresh to the latest timer"/>
    </enum>

    <enum name="BuffAttributeType" comment="Attribute modified by Buffs">
        <var name="MoveSpeed" value="0" comment="Base walking speed"/>
        <var name="SprintSpeed" value="1" comment="Sprint speed"/>
        <var name="StaminaCostCoef" value="2" comment="Sprint stamina cost coefficient"/>
        <var name="CurrentHealth" value="3" comment="Current health immediate effect"/>
        <var name="MaxCarryWeight" value="4" comment="Maximum carry weight"/>
        <var name="DamageBonusCoef" value="5" comment="Outgoing damage bonus"/>
        <var name="DamageReductionCoef" value="6" comment="Incoming damage reduction"/>
        <var name="HealBonusCoef" value="7" comment="Outgoing healing bonus"/>
        <var name="ReceiveHealBonusCoef" value="8" comment="Incoming healing bonus"/>
    </enum>

    <enum name="BuffModifyMode" comment="Buff attribute modification mode">
        <var name="FlatAdd" value="0" comment="Absolute additive value"/>
        <var name="RateAdd" value="1" comment="Percentage additive value"/>
        <var name="FlatOverride" value="2" comment="Absolute override"/>
        <var name="RateOverride" value="3" comment="Coefficient override"/>
    </enum>

    <enum name="EnemySkillReleaseConditionType" comment="Enemy skill release condition type">
        <var name="TargetDistance" value="1" comment="Distance to target"/>
    </enum>

    <enum name="EnemySkillReleaseConditionRelation" comment="How enemy skill release conditions combine">
        <var name="All" value="1" comment="Every condition must be met"/>
        <var name="Any" value="2" comment="At least one condition must be met"/>
    </enum>

    <bean name="BuffAttributeModifier" valueType="1" sep=";" comment="Single Buff attribute modifier">
        <var name="attr" type="BuffAttributeType" comment="Attribute type"/>
        <var name="mode" type="BuffModifyMode" comment="Modification mode"/>
        <var name="value" type="float" comment="Configured value"/>
        <var name="tickEnabled" type="bool" comment="Whether this modifier repeats over time"/>
        <var name="tickInterval" type="float" comment="Tick interval in seconds"/>
        <var name="tickMaxCount" type="int" comment="Maximum tick count, zero or less means unlimited"/>
    </bean>

    <bean name="EnemySkillReleaseCondition" valueType="1" sep=";" comment="单个敌人技能释放条件">
        <var name="conditionType" type="EnemySkillReleaseConditionType" comment="稳定条件类型；TargetDistance 表示与目标的平面距离"/>
        <var name="minValue" type="float" comment="条件最小值"/>
        <var name="maxValue" type="float" comment="条件最大值"/>
    </bean>

    <bean name="WeaponCombat" comment="核心战斗参数（对照鸭科夫参考表）">
        <var name="damage" type="float" comment="伤害"/>
        <var name="fireRate" type="float" comment="射速（发/秒）"/>
        <var name="magazineCapacity" type="int" comment="弹匣容量"/>
        <var name="critRate" type="float" comment="暴击率"/>
        <var name="critMultiplier" type="float" comment="暴击伤害倍率"/>
        <var name="armorBreak" type="float" comment="护甲破坏"/>
        <var name="shootCameraShake" type="WeaponCameraShake" comment="射击屏幕抖动配置"/>
    </bean>

    <bean name="WeaponCameraShake" comment="射击屏幕抖动配置">
        <var name="enabled" type="bool" comment="是否启用"/>
        <var name="forwardAmplitude" type="float" comment="射击方向抖动幅度"/>
        <var name="perpendicularAmplitude" type="float" comment="射击垂直方向抖动幅度"/>
        <var name="frequency" type="float" comment="频率"/>
        <var name="duration" type="float" comment="持续时间"/>
        <var name="decay" type="float" comment="衰减时间"/>
        <var name="noiseStrength" type="float" comment="噪声权重"/>
        <var name="randomStrength" type="float" comment="随机权重"/>
    </bean>

    <bean name="WeaponBallistics" comment="弹道与命中参数（对照鸭科夫参考表）">
        <var name="maxRange" type="float" comment="子弹最大飞行距离"/>
        <var name="falloffStart" type="float" comment="子弹伤害衰减距离"/>
        <var name="falloffMultiplier" type="float" comment="超距离伤害系数"/>
        <var name="bulletSpeed" type="float" comment="子弹速度"/>
        <var name="pelletsPerShot" type="int" comment="单发子弹数"/>
        <var name="penetration" type="int" comment="单位穿透"/>
    </bean>

    <bean name="WeaponHandling" comment="操控与换弹参数（对照鸭科夫参考表）">
        <var name="reloadTime" type="float" comment="换弹时间"/>
        <var name="burstCount" type="int" comment="连发数"/>
        <var name="semiAutoFireInterval" type="float" comment="半自动连发结束冷却（秒，0 使用射速间隔）"/>
        <var name="adsTime" type="float" comment="瞄准时间"/>
        <var name="minAimDistance" type="float" comment="最小瞄准距离"/>
        <var name="maxAimDistance" type="float" comment="最大瞄准距离"/>
        <var name="aimCameraMaxOffset" type="float" comment="瞄准相机最大偏移距离"/>
        <var name="moveSpeedMul" type="float" comment="移动速度系数"/>
        <var name="adsMoveSpeedMul" type="float" comment="瞄准移动系数"/>
        <var name="fireGateConeAngle" type="float" comment="开火判定远端半角（度）"/>
        <var name="fireGateNearHalfWidth" type="float" comment="开火判定台形近端半宽（米）"/>
        <var name="autoFireConeRadius" type="float" comment="自动开火检测半径（米）"/>
        <var name="fireGateSettleTime" type="float" comment="开火判定区内持续瞄准时间（秒）"/>
        <var name="fireGateMaxAimSpeed" type="float" comment="瞄准角速度上限（度/秒）"/>
        <var name="fireGateBreakGraceSeconds" type="float" comment="锁定目标失效宽限时间（秒）"/>
        <var name="fireGateCombatBreakGraceSeconds" type="float" comment="战斗保持时锁定目标失效宽限时间（秒）"/>
        <var name="combatSustainAfterShotSeconds" type="float" comment="射击后战斗保持时间（秒）"/>
        <var name="combatAimSustainSeconds" type="float" comment="战斗瞄准保持时间（秒）"/>
    </bean>

    <bean name="WeaponSpread" comment="腰射/瞄准散布参数（对照鸭科夫参考表）">
        <var name="hipSpreadBase" type="float" comment="腰射基础散布（度）"/>
        <var name="hipSpreadMax" type="float" comment="腰射最大扩散（度）"/>
        <var name="hipSpreadGrowth" type="float" comment="腰射扩散增长（度/发）"/>
        <var name="hipSpreadRecover" type="float" comment="腰射扩散恢复（度/秒）"/>
    </bean>

    <bean name="WeaponReticle" comment="uGUI 准星显示参数">
        <var name="innerLineLength" type="float" comment="白色内线长度（HUD 参考像素）"/>
        <var name="innerLineThickness" type="float" comment="白色内线厚度（HUD 参考像素）"/>
        <var name="outlineThickness" type="float" comment="黑色外描边单侧厚度（HUD 参考像素）"/>
        <var name="oppositeArmDistance" type="float" comment="对向准星臂白色内侧间距（HUD 参考像素）"/>
        <var name="spreadMaxDistanceAdd" type="float" comment="最大散布时对向准星臂额外间距（HUD 参考像素）"/>
        <var name="spreadExpandSpeed" type="float" comment="准星扩散视觉跟随速度（HUD 参考像素/秒）"/>
        <var name="spreadRecoverSpeed" type="float" comment="准星收拢视觉跟随速度（HUD 参考像素/秒）"/>
        <var name="shakeAnglePerShot" type="float" comment="每枪增加的旋转抖动角度（度）"/>
        <var name="shakeMaxAngle" type="float" comment="最大旋转抖动角度（度）"/>
        <var name="shakeFrequency" type="float" comment="抖动正弦频率（Hz）"/>
        <var name="shakeRecoverSpeed" type="float" comment="抖动幅度恢复速度（度/秒）"/>
        <var name="innerLineColorR" type="float" comment="准星白色内线颜色 R（0-1）"/>
        <var name="innerLineColorG" type="float" comment="准星白色内线颜色 G（0-1）"/>
        <var name="innerLineColorB" type="float" comment="准星白色内线颜色 B（0-1）"/>
        <var name="innerLineColorA" type="float" comment="准星白色内线颜色 A（0-1）"/>
        <var name="outlineColorR" type="float" comment="准星黑色描边颜色 R（0-1）"/>
        <var name="outlineColorG" type="float" comment="准星黑色描边颜色 G（0-1）"/>
        <var name="outlineColorB" type="float" comment="准星黑色描边颜色 B（0-1）"/>
        <var name="outlineColorA" type="float" comment="准星黑色描边颜色 A（0-1）"/>
        <var name="reloadIndicatorColorR" type="float" comment="换弹指示器颜色 R（0-1）"/>
        <var name="reloadIndicatorColorG" type="float" comment="换弹指示器颜色 G（0-1）"/>
        <var name="reloadIndicatorColorB" type="float" comment="换弹指示器颜色 B（0-1）"/>
        <var name="reloadIndicatorColorA" type="float" comment="换弹指示器颜色 A（0-1）"/>
        <var name="reloadIndicatorSize" type="float" comment="换弹指示器尺寸（HUD 参考像素）"/>
        <var name="reloadIndicatorRotationSpeed" type="float" comment="换弹指示器旋转速度（度/秒）"/>
    </bean>

    <bean name="WeaponRecoil" comment="后坐力参数（对照鸭科夫参考表）">
        <var name="verticalRecoil" type="float" comment="垂直后坐力"/>
        <var name="horizontalRecoil" type="float" comment="水平后坐力"/>
        <var name="recoilRecoveryStart" type="float" comment="后坐力恢复起始时间"/>
        <var name="recoilRecovery" type="float" comment="后坐力恢复"/>
        <var name="recoilVerticalMin" type="float" comment="最小垂直后坐力系数"/>
        <var name="recoilVerticalMax" type="float" comment="最大垂直后坐力系数"/>
        <var name="recoilHorizontalMin" type="float" comment="最小水平后坐力系数"/>
        <var name="recoilHorizontalMax" type="float" comment="最大水平后坐力系数"/>
        <var name="recoilDuration" type="float" comment="后坐力持续时间"/>
    </bean>

    <bean name="WeaponItemMeta" comment="物品与经济参数（对照鸭科夫参考表）">
        <var name="soundMultiplier" type="float" comment="声音倍率"/>
    </bean>

    <bean name="AttachmentStatModifier" valueType="1" sep=";" comment="单项配件属性修改">
        <var name="stat" type="AttachmentStatType" comment="目标武器属性"/>
        <var name="mode" type="AttachmentModifierMode" comment="叠加方式"/>
        <var name="value" type="float" comment="固定值或比例值"/>
    </bean>

    <bean name="Weapon" comment="武器配置（对照鸭科夫参考表）">
        <var name="id" type="int" comment="武器配置 ID"/>
        <var name="displayName" type="string" comment="武器名称"/>
        <var name="weaponType" type="WeaponType" comment="类型（步枪/冲锋枪/手枪/霰弹枪）"/>
        <var name="fireMode" type="FireMode" comment="自动化（全自动/半自动）"/>
        <var name="combat" type="WeaponCombat" comment="核心战斗参数"/>
        <var name="ballistics" type="WeaponBallistics" comment="弹道与命中参数"/>
        <var name="handling" type="WeaponHandling" comment="操控与换弹参数"/>
        <var name="spread" type="WeaponSpread" comment="散布参数"/>
        <var name="reticle" type="WeaponReticle" comment="uGUI 准星参数"/>
        <var name="recoil" type="WeaponRecoil" comment="后坐力参数"/>
        <var name="itemMeta" type="WeaponItemMeta" comment="物品与经济参数"/>
        <var name="weaponPrefabPath" type="string" comment="武器预制体"/>
        <var name="weaponAudioProfilePath" type="string" comment="枪械音效配置完整 Assets 路径"/>
        <var name="bulletImpactAudioProfilePath" type="string" comment="子弹命中音效配置完整 Assets 路径"/>
        <var name="weaponVisualProfilePath" type="string" comment="武器开火视觉 Profile 完整 Assets 路径"/>
        <var name="bulletImpactVisualProfilePath" type="string" comment="子弹命中视觉 Profile 完整 Assets 路径"/>
        <var name="characterMoveConfig" type="string" comment="角色移动配置完整 Assets 路径"/>
        <var name="attachmentSlots" type="list,AttachmentSlotType" comment="该武器开放的配件槽位"/>
    </bean>

    <bean name="MeleeWeapon" comment="近战武器配置">
        <var name="id" type="int" comment="近战武器配置 ID"/>
        <var name="displayName" type="string" comment="近战武器名称"/>
        <var name="critRate" type="float" comment="暴击率"/>
        <var name="critMultiplier" type="float" comment="暴击伤害倍率"/>
        <var name="armorBreak" type="float" comment="护甲破坏"/>
        <var name="attackRange" type="float" comment="自动选敌距离（米）"/>
        <var name="targetHalfAngle" type="float" comment="自动选敌扇区半角（度）"/>
        <var name="moveSpeedMul" type="float" comment="攻击期间移动速度系数"/>
        <var name="weaponPrefabPath" type="string" comment="正式近战武器 Prefab 完整 Assets 路径"/>
        <var name="skillConfigPath" type="string" comment="关联近战技能完整 Assets 路径"/>
    </bean>

    <bean name="Item" comment="物品配置">
        <var name="id" type="int" comment="ID"/>
        <var name="displayNameKey" type="string" comment="显示名称本地化键"/>
        <var name="descriptionKey" type="string" comment="物品描述本地化键"/>
        <var name="itemPrefabPath" type="string" comment="物品地面模型 Prefab 完整 Assets 路径"/>
        <var name="quantity" type="int" comment="掉落数量"/>
        <var name="itemType" type="ItemType" comment="物品类型"/>
        <var name="itemRefId" type="int" comment="关联物品 ID"/>
        <var name="value" type="int" comment="价值"/>
        <var name="contact1BuyPriceMultiplier" type="float" comment="联络人 ID=1（伊万 科瓦尔）购买价格倍率；单价=价值×倍率。"/>
        <var name="contact2BuyPriceMultiplier" type="float" comment="联络人 ID=2（保尔 柯察金）购买价格倍率；单价=价值×倍率。"/>
        <var name="contact3BuyPriceMultiplier" type="float" comment="联络人 ID=3（乔伊纳）购买价格倍率；单价=价值×倍率。"/>
        <var name="contact4BuyPriceMultiplier" type="float" comment="联络人 ID=4（高扬斯卡娅）购买价格倍率；单价=价值×倍率。"/>
        <var name="weight" type="float" comment="重量"/>
        <var name="maxStackCount" type="int" comment="最大堆叠数"/>
        <var name="maxUseCount" type="int" comment="最大使用次数；0 表示不使用次数"/>
        <var name="maxDurability" type="int" comment="最大耐久"/>
        <var name="durabilityCost" type="int" comment="耐久消耗"/>
        <var name="isMultiUse" type="bool?" comment="是否可多次使用；为空时不参与使用次数判定"/>
        <var name="searchTime" type="float" comment="战利品箱单格搜索时间，单位秒"/>
        <var name="itemQuality" type="int" comment="道具品质：1=绿，2=蓝，3=紫，4=金，5=红"/>
        <var name="itemIconPath" type="string" comment="道具 ICON UI 素材完整 Assets 路径"/>
        <var name="canSell" type="bool" comment="是否允许出售"/>
    </bean>

    <bean name="Medicine" comment="药品配置">
        <var name="id" type="int" comment="药品 ID"/>
        <var name="name" type="string" comment="药品名称"/>
        <var name="medicineType" type="MedicineType" comment="药品类型"/>
        <var name="buffId" type="int" comment="关联 Buff ID"/>
        <var name="useDuration" type="float" comment="使用耗时（秒）"/>
        <var name="useActionConfig" type="string" comment="药品使用动作配置 Key"/>
        <var name="useMoveSpeedMul" type="float" comment="使用移动系数"/>
        <var name="allowWhenFullHealth" type="bool" comment="满血时是否允许使用"/>
        <var name="requireDebuff" type="bool" comment="是否要求身上存在减益 Buff"/>
    </bean>

    <bean name="Ammo" comment="弹药配置">
        <var name="id" type="int" comment="弹药 ID"/>
        <var name="name" type="string" comment="弹药名称"/>
        <var name="level" type="int" comment="子弹等级，同时作为穿甲等级"/>
        <var name="weaponWearRate" type="float" comment="每发消耗武器原始耐久上限的比例"/>
        <var name="armorBreakGain" type="float" comment="子弹护甲破坏加成"/>
        <var name="damageBonusRate" type="float" comment="子弹额外增伤系数，0.2 表示额外增加 20% 伤害"/>
    </bean>

    <bean name="Equipment" comment="装备配置">
        <var name="id" type="int" comment="装备 ID"/>
        <var name="name" type="string" comment="装备名称"/>
        <var name="slotType" type="EquipmentSlotType" comment="穿戴槽位"/>
        <var name="extraInventorySlots" type="int" comment="额外背包格数"/>
        <var name="armorClass" type="int" comment="护甲等级"/>
        <var name="maxCarryWeightBonus" type="float" comment="额外最大负重"/>
        <var name="hearingRangeMultiplier" type="float" comment="可听距离倍率"/>
        <var name="showSoundDirection" type="bool" comment="是否显示声音方向"/>
        <var name="critRateBonus" type="float" comment="武器暴击率固定加成（0.1 表示 10 个百分点）"/>
        <var name="headDamageReduction" type="float" comment="头部伤害减免（0.2 表示降低 20%）"/>
        <var name="infraredScanEnabled" type="bool" comment="是否启用红外扫描"/>
        <var name="infraredScanRadius" type="float" comment="红外扫描半径（米）"/>
        <var name="infraredScanInterval" type="float" comment="红外扫描间隔（秒）"/>
        <var name="infraredRevealDuration" type="float" comment="敌人红色残影持续时间（秒）"/>
        <var name="infraredWaveDuration" type="float" comment="扫描波纹持续时间（秒）"/>
    </bean>

    <bean name="Attachment" comment="配件配置">
        <var name="id" type="int" comment="配件 ID"/>
        <var name="name" type="string" comment="配件名称"/>
        <var name="slotType" type="AttachmentSlotType" comment="占用的配件槽位"/>
        <var name="isSuppressor" type="bool" comment="是否为消音器；仅控制枪械音频分支"/>
        <var name="compatibleWeaponIds" type="list,int" comment="兼容武器 ID；为空表示兼容所有开放该槽位的武器"/>
        <var name="modifiers" type="list,AttachmentStatModifier" comment="实际武器属性修改列表"/>
    </bean>

    <bean name="Buff" comment="Buff runtime configuration">
        <var name="id" type="int" comment="Buff ID"/>
        <var name="nameKey" type="string" comment="Player-facing name localization key"/>
        <var name="descriptionKey" type="string" comment="Player-facing description localization key"/>
        <var name="priority" type="int" comment="Lower values are processed earlier"/>
        <var name="tag" type="BuffTag" comment="Buff category"/>
        <var name="conflictBuffIds" type="list,int" comment="Conflicting Buff IDs"/>
        <var name="conflictTags" type="list,BuffTag" comment="Conflicting Buff tags"/>
        <var name="conflictPolicy" type="BuffConflictPolicy" comment="Conflict handling policy"/>
        <var name="durationMode" type="BuffDurationMode" comment="Duration mode"/>
        <var name="duration" type="float" comment="Timed duration in seconds"/>
        <var name="repeatPolicy" type="BuffRepeatPolicy" comment="Duplicate application policy"/>
        <var name="stackDurationPolicy" type="BuffStackDurationPolicy" comment="Stack duration behavior"/>
        <var name="maxStack" type="int" comment="Maximum stack count"/>
        <var name="removeOnDeath" type="bool" comment="Remove this Buff when owner dies"/>
        <var name="endApplyBuffIds" type="list,int" comment="Buff IDs to apply when this Buff is removed"/>
        <var name="cleanseBuffIds" type="list,int" comment="Buff IDs whose stacks are reduced when this Buff is applied"/>
        <var name="cleanseTags" type="list,BuffTag" comment="Buff tags whose stacks are reduced when this Buff is applied"/>
        <var name="cleanseStackCount" type="int" comment="Stack count reduced for each matched Buff; zero disables cleanse"/>
        <var name="attributes" type="list,BuffAttributeModifier" comment="Attribute modifiers"/>
        <var name="applyVfxPath" type="string" comment="One-shot VFX path when applied"/>
        <var name="loopVfxPath" type="string" comment="Looping VFX path while active"/>
        <var name="removeVfxPath" type="string" comment="One-shot VFX path when removed"/>
        <var name="vfxSocket" type="string" comment="Owner socket name for VFX"/>
        <var name="specialScript" type="string" comment="Whitelisted special logic key"/>
        <var name="customKeys" type="list,string" comment="Custom parameter names"/>
        <var name="customValues" type="list,float" comment="Custom parameter values"/>
    </bean>

    <bean name="Localization" comment="Player-facing localization string">
        <var name="key" type="string" comment="Stable semantic localization key"/>
        <var name="zhHans" type="string" comment="Required Simplified Chinese text"/>
        <var name="en" type="string" comment="English text; empty falls back to Simplified Chinese"/>
        <var name="ar" type="string" comment="Arabic text; empty falls back to Simplified Chinese"/>
        <var name="context" type="string" comment="Translator context and usage"/>
    </bean>

</module>
