*.mdb.meta

# Unity crash reports and generated assets
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/AssetStoreTools*
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/StreamingAssets/aa*

# Local credentials and operating system files
.env
.env.*
!.env.example
*.keystore
*.jks
.DS_Store
Thumbs.db

# Reports: retain historical tracked evidence; new run outputs and former Logs stay local.
/Reports/*/
!/Reports/Archive/
/Reports/Archive/*/Logs/
/Reports/Archive/*/Temp/
